*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Models (太大，不提交)
models/
*.pth
*.pt
*.onnx
*.bin

# Audio files (示例除外)
*.mp3
*.wav
*.flac
*.ogg
*.aac
!examples/input/*.mp3
!examples/output/*.mp3

# Temporary files
temp/
tmp/
*.tmp
*.temp

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Test
.pytest_cache/
.coverage
htmlcov/

# Config (可能包含敏感信息)
config/local.yaml
.env
.env.local